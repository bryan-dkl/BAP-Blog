---
// Blog editor — write new posts or edit existing ones, with pictures, videos, files and embeds.
//
// - On the live site (GitHub Pages) it saves by committing to the GitHub repo with your own GitHub token.
//   The commit triggers the deploy workflow, so the post is online 1–2 minutes later.
// - With `npm run dev` it saves straight into your project folder (add ?mode=github to test the GitHub flow locally).
//
// The logic lives in src/lib/editor/.
import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS, POST_TYPES, pillarKeys, postTypeKeys } from '../data/taxonomy';
import { GITHUB } from '../data/github';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const today = new Date().toISOString().slice(0, 10);
const mode = import.meta.env.DEV ? 'local' : 'github';
const repoUrl = `https://github.com/${GITHUB.owner}/${GITHUB.repo}`;
---

<BaseLayout title="Editor" noindex>
  <div
    class="editor"
    id="editor"
    data-base={baseUrl}
    data-mode={mode}
    data-owner={GITHUB.owner}
    data-repo={GITHUB.repo}
    data-branch={GITHUB.branch}
  >
    <!-- Step 1 (live site only): connect with a GitHub token -->
    <section class="connect" id="connect" hidden>
      <h1>Write a post</h1>
      <p>
        New posts are saved straight to the
        <a href={repoUrl} target="_blank" rel="noopener">{GITHUB.owner}/{GITHUB.repo}</a> repository, which then
        rebuilds the site. To do that, connect once with your own GitHub token.
      </p>

      <details class="token-help">
        <summary>How do I get a token?</summary>
        <ol>
          <li>
            You need to be the owner or a collaborator of <strong>{GITHUB.owner}/{GITHUB.repo}</strong> (repo → Settings →
            Collaborators).
          </li>
          <li>
            <strong>Repo owner:</strong> create a
            <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">fine-grained token</a>
            → Repository access: <em>Only select repositories</em> → {GITHUB.repo} → Permissions:
            <em>Contents: Read and write</em>.
          </li>
          <li>
            <strong>Collaborators:</strong> create a
            <a href="https://github.com/settings/tokens/new?scopes=public_repo&description=BAP-Blog%20editor" target="_blank" rel="noopener">classic token</a>
            with the <em>public_repo</em> scope (fine-grained tokens can't access other people's repos).
          </li>
          <li>Pick an expiration date (e.g. end of the school year), generate it and paste it below.</li>
        </ol>
        <p class="muted">
          The token is only stored in this browser and only sent to GitHub. Never share it or commit it.
        </p>
      </details>

      <form id="connect-form" class="post-form connect-form">
        <label>
          GitHub token
          <input id="token-input" type="password" autocomplete="off" placeholder="github_pat_… or ghp_…" required />
        </label>
        <label class="check"><input type="checkbox" id="token-remember" checked /> Remember on this device</label>
        <div class="form-actions">
          <button type="submit" class="button">Connect</button>
        </div>
        <p class="form-status" id="connect-status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <!-- Step 2: the editor -->
    <div id="workspace" hidden>
      <div class="editor-head">
        <h1 id="editor-title">New post</h1>
        <label class="editor-pick">
          <span class="muted">Edit an existing post</span>
          <select id="post-picker">
            <option value="">+ New post</option>
          </select>
        </label>
      </div>

      <p class="editor-bar" id="connected" hidden>
        Saving to GitHub as <strong id="connected-user"></strong> ·
        <button type="button" class="link-button" id="disconnect">Disconnect</button>
      </p>
      <p class="editor-bar muted" data-mode-only="local" hidden>
        Local mode: saving writes into your project folder. Commit &amp; push to put it online.
      </p>

      <form id="post-form" class="post-form" novalidate>
        <input type="hidden" name="id" />
        <input type="hidden" name="removeCover" value="" />

        <div class="form-row">
          <label class="grow">
            Title
            <input name="title" required placeholder="e.g. First usability test with 5 students" />
          </label>
          <label>
            Date
            <input name="date" type="date" value={today} required />
          </label>
        </div>

        <label>
          Short description <span class="muted">(optional, shown on the overview)</span>
          <input name="description" />
        </label>

        <fieldset>
          <legend>Pillars <span class="muted">(at least one)</span></legend>
          {pillarKeys.map((key) => (
            <label class="check"><input type="checkbox" name="pillars" value={key} /> {PILLARS[key].label}</label>
          ))}
        </fieldset>

        <fieldset>
          <legend>Type <span class="muted">(optional)</span></legend>
          {postTypeKeys.map((key) => (
            <label class="check"><input type="checkbox" name="types" value={key} /> {POST_TYPES[key].label}</label>
          ))}
        </fieldset>

        <label>
          Authors <span class="muted">(comma separated)</span>
          <input name="authors" placeholder="Bryan, ..." />
        </label>

        <fieldset class="cover-field">
          <legend>Cover image <span class="muted">(optional)</span></legend>
          <div class="cover-preview" id="cover-preview" hidden>
            <img id="cover-img" alt="" />
            <button type="button" class="link-button" id="cover-remove">Remove cover</button>
          </div>
          <input type="file" id="cover-input" accept=".jpg,.jpeg,.png,.webp,.gif,.avif,.svg" />
          <label class="grow">
            Cover description <span class="muted">(alt text)</span>
            <input name="coverAlt" placeholder="What's in the picture?" />
          </label>
        </fieldset>

        <div class="field">
          <span class="field-label">Content <span class="muted">(Markdown)</span></span>
          <div class="toolbar" role="toolbar" aria-label="Formatting">
            <button type="button" data-md="h2" title="Heading">H2</button>
            <button type="button" data-md="h3" title="Sub-heading">H3</button>
            <button type="button" data-md="bold" title="Bold (⌘B)"><b>B</b></button>
            <button type="button" data-md="italic" title="Italic (⌘I)"><i>I</i></button>
            <button type="button" data-md="link" title="Link (⌘K)">Link</button>
            <button type="button" data-md="ul" title="Bullet list">• List</button>
            <button type="button" data-md="ol" title="Numbered list">1. List</button>
            <button type="button" data-md="quote" title="Quote">“ Quote</button>
            <button type="button" data-md="code" title="Code block">&lt;/&gt;</button>
            <span class="toolbar__sep" aria-hidden="true"></span>
            <button type="button" data-action="image">🖼 Picture</button>
            <button type="button" data-action="file">📎 Video / file</button>
            <button type="button" data-action="embed">▶ Embed</button>
          </div>
          <textarea name="body" id="body" rows="20" placeholder="Write your post… Drag & drop or paste pictures straight in here."></textarea>
          <p class="hint muted">
            Tip: drag &amp; drop or paste pictures into the text. Embed works with YouTube, Vimeo and Figma links.
          </p>
          <input type="file" id="image-input" accept="image/*" multiple hidden />
          <input type="file" id="file-input" multiple hidden />
        </div>

        <section class="attachments" id="attachments" hidden>
          <h2>Files that will be uploaded</h2>
          <ul id="attachment-list"></ul>
        </section>

        <p class="form-status" id="status" role="status" aria-live="polite"></p>

        <div class="form-actions">
          <button type="submit" class="button" data-draft="false">Publish</button>
          <button type="submit" class="button button--secondary" data-draft="true">Save as draft</button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import { initEditor } from '../lib/editor/editor.js';

  const root = document.getElementById('editor');
  if (root) initEditor(root);
</script>
