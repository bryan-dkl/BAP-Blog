---
import { Image } from 'astro:assets';
import Tags from './Tags.astro';
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, description, pillars, types, draft, cover } = post.data;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<li class:list={['post-card', { 'post-card--cover': cover }]} data-pillars={pillars.join(' ')} data-types={types.join(' ')}>
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  <div>
    <h3>
      <a href={`${baseUrl}blog/${post.id}/`}>{title}</a>
      {draft && <span class="draft-badge">draft</span>}
    </h3>
    {description && <p>{description}</p>}
    <Tags pillars={pillars} types={types} />
  </div>
  {cover && <Image src={cover} alt="" width={240} class="post-card__thumb" loading="lazy" />}
</li>
